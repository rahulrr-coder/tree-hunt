# Any OpenAI-compatible vision model works. Defaults point at Google AI Studio + Gemma.
MODEL_API_KEY=
MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MODEL_NAME=gemma-3-27b-it

# Leave MONGODB_URI empty for an in-memory store (dev only; data resets on restart).
MONGODB_URI=
MONGODB_DB=treehunt

VERIFY_RATE_LIMIT_PER_HOUR=20
APP_TIMEZONE=Asia/Kolkata
